---
import Base from "../layouts/Base.astro";
---

<Base>
  <section class="stage">
    <div class="stage__inner wrap">
      <p class="stage__eyebrow eyebrow" data-hero-fade>Software Engineer</p>

      <h1 class="stage__handle" data-split data-drop>sizukutamago</h1>

      <p class="stage__desc" data-hero-fade>
        AI 開発と、色々な Web アプリを作ってます。
      </p>

      <nav class="stage__links" data-hero-fade aria-label="Links">
        <a class="u-link" href="https://github.com/sizukutamago" target="_blank" rel="noopener">
          GitHub <span aria-hidden="true">↗</span>
        </a>
        <a class="u-link" href="https://x.com/sizukutamago" target="_blank" rel="noopener">
          X <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </div>
  </section>
</Base>

<style>
  .stage {
    min-height: 100svh;
    display: flex;
    align-items: center;
  }
  .stage__inner {
    width: 100%;
  }
  .stage__eyebrow {
    margin-bottom: 1.75rem;
  }
  .stage__handle {
    font-family: "Bricolage Grotesque Variable", var(--font-display);
    font-weight: 600;
    font-variation-settings: "opsz" 96;
    font-size: clamp(2.8rem, 0.5rem + 12vw, 10rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--ink);
    cursor: default;
  }
  .stage__desc {
    max-width: 42ch;
    margin-top: 2rem;
    font-size: var(--step-1);
    color: var(--ink-2);
    line-height: 1.6;
  }
  .stage__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.75rem;
    margin-top: 2.5rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    letter-spacing: 0.02em;
  }
</style>
